{
  "rules": {
    ".read": false,
    ".write": false,

    "poll": {
      "days": {
        "$day": {
          ".read": true,
          "counts": {
            "$group": {
              ".validate": "$day === '' + ((now + 25200000 - (now + 25200000) % 86400000) / 86400000) && ($group === 'g1' || $group === 'g2' || $group === 'g3') && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.parent().parent().parent().parent().child('voters').child(auth.uid).val() === now",
              ".write": "auth != null && (!root.child('poll/voters').child(auth.uid).exists() || now >= root.child('poll/voters').child(auth.uid).val() + 3600000)"
            }
          }
        }
      },
      "voters": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || now >= data.val() + 3600000)",
          ".validate": "newData.isNumber() && newData.val() === now"
        }
      }
    }
  }
}
